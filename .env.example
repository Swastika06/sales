# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://partner_portal:partner_portal@localhost:5432/partner-portal

# MinIO API endpoint (do not include http:// or a path)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=partner-portal

# Authentication. Replace for every non-local environment.
JWT_SECRET_KEY=change-me-to-a-long-random-secret-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Idempotent development seed administrator
SEED_ADMIN_EMAIL=admin@tcgdigital.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=TCG Administrator

# Frontend. Leave empty to use Vite's /api development proxy.
VITE_API_URL=

VITE_PROXY_TARGET=http://127.0.0.1:8000
